# Copy to .env for local runs; CI and the homelab worker use real secrets.
# Existing environment variables always win over .env.

# Jev (TypeSafe AI) triage. Without it, triage falls back to readable rules.
TYPESAFE_API_KEY=

# Optional: Hugging Face (gated model cards) and GitHub (search rate limits).
HF_TOKEN=
GITHUB_TOKEN=

# Homelab worker only (see deploy/homelab/env.example).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
