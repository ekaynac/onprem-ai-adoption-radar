# Runtime data. Only the Pulse item store and label cache are versioned (the
# publish workflow persists them); everything else is per-run or per-host.
data/*
!data/.gitkeep
!data/pulse/
data/pulse/*
!data/pulse/items.jsonl
!data/pulse/labels.jsonl

# Brand kit (corporate identity originals, design files) is kept OUTSIDE this
# repo; only the web logo, favicon and fonts live in frontend/.
brand-kit/

# Local secrets (TYPESAFE_API_KEY, HF_TOKEN, ...) read by radar.pulse.env
.env
.env.*
!.env.example

