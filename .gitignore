__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
frontend/node_modules/
frontend/*.tsbuildinfo
build/

# Brand kit (corporate identity originals, design files) is kept OUTSIDE this
# repo — never commit it here.
brand-kit/

# Local runtime data (generated by `radar init` / `radar scan`)
data/runs/
data/*.db
# D5 (2026-07-27 spec): local scans (no --publish-history) log to this
# disposable lane instead of the committed data/history.jsonl.
data/local/
data/config.yaml
data/config.yaml.bak
# Durable history log: ignored by default so local/test timelines aren't
# committed. To version your history (recommended for self-hosting durability),
# `git add -f data/history.jsonl`. See docs/persistence.md.
data/history.jsonl
# Durable source-health log: ignored by default so local/test runs aren't
# committed. To version it (recommended for self-hosting durability),
# `git add -f data/source-health.jsonl`. See docs/persistence.md.
data/source-health.jsonl
# Stray DB created by running radar with the wrong --root (the real one is
# data/radar.db, covered by data/*.db above).
/radar.db
# Human decisions and discovery proposals (local runtime state).
data/overrides.yaml
data/proposed-seeds.yaml
data/proposed-model-seeds.yaml
data/proposed-technique-seeds.yaml

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# macOS
.DS_Store

# Playwright MCP scratch artifacts
.playwright-mcp/

# Local isolated feature worktrees
.worktrees/
