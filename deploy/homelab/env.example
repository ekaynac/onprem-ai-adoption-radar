# /etc/radar/env on ct-radar — owner root:radar, mode 0640. Never commit real values.
#
# Memati (@memati_claw_bot): the daily Pulse digest.
TELEGRAM_BOT_TOKEN=
# Çakır (@cakir_claw_bot): watchdog alerts. Falls back to Memati when empty.
TELEGRAM_ALERT_BOT_TOKEN=
# The owner's Telegram user id (the DM chat with both bots).
TELEGRAM_CHAT_ID=
# Claude subscription token for the Turkish one-line summaries: run
# `claude setup-token` on the owner's Mac (valid for one year) and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
